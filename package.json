{
	"name": "rskills-cli",
	"version": "0.3.0",
	"description": "Read remote skills without installing them",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"rskills": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/rskills.git"
	},
	"bugs": {
		"url": "https://github.com/fdarian/rskills/issues"
	},
	"homepage": "https://github.com/fdarian/rskills#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"start": "bun run src/cli.ts",
		"build": "bun run scripts/build.ts",
		"build:binaries": "bun run scripts/build-binaries.ts",
		"prepack": "pnpm run build",
		"check:type": "tsc --noEmit",
		"format": "biome check --write .",
		"check:lint": "biome check .",
		"check": "pnpm run check:type && pnpm run check:lint",
		"ci:version": "changeset version",
		"ci:release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@changesets/cli": "^2.31.0",
		"@effect/platform-node": "4.0.5",
		"@types/bun": "latest",
		"@types/react": "^19.2.17",
		"effect": "4.0.5",
		"incur": "^0.4.8",
		"ink": "^7.0.6",
		"react": "^19.2.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@12.14.0"
}
